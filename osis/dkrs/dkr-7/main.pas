uses GraphABC, fractal_pas; 
// Подключение графической библиотеки и модуля с логикой фрактала

var
  Depth: integer := 3;     // Начальная глубина рекурсии фрактала
  StartY: integer := 250; // Начальная координата Y точки старта рисования
  StartX: integer := 250; // Начальная координата X точки старта рисования



// --------------------------------------------------
// Процедура DrawUI — отрисовка панели управления
procedure DrawUI;
begin
  // Настройка цвета заливки и пера
  SetBrushColor(clLightGray);
  SetPenColor(clBlack);

  // Отрисовка фона панели управления
  FillRectangle(10, 10, 260, 170);
  Rectangle(10, 10, 260, 170);
  
  // Текстовая информация об управлении
  TextOut(20, 20,  'Управление:');
  TextOut(20, 40,  '+ / -   : Масштаб');
  TextOut(20, 60,  'Ctrl / Shift   : Глубина');
  TextOut(20, 80,  'Стрелки : Перемещение окна');
  
  // Отображение текущих значений параметров
  TextOut(20, 125, 'Глубина = ' + Depth.ToString);
  TextOut(20, 145, 'Масштаб = ' + StepSize.ToString);
end;



// --------------------------------------------------
// Процедура Redraw — полная перерисовка сцены
procedure Redraw();
begin
  LockDrawing();           // Блокировка перерисовки для устранения мерцания
  ClearWindow;             // Очистка окна
  
  // Установка начальной точки рисования
  MoveTo(StartX, StartY);
  
  angle := 1;              // Сброс начального направления движения
  
  // Запуск рекурсивного построения фрактала
  Fractal(Depth, -1);
  
  // Отрисовка интерфейса поверх фрактала
  DrawUI();
  
  UnlockDrawing();         // Разблокировка и вывод изображения на экран
end;



// --------------------------------------------------
// Обработчик нажатий клавиш
procedure KeyDown(Key: integer);
begin
  case Key of 
    // Увеличение глубины рекурсии
    VK_ShiftKey: Depth := Depth + 1;         
    
    // Уменьшение глубины рекурсии (не ниже 1)
    VK_ControlKey: 
      if Depth > 1 then Depth := Depth - 1;
    
    // Увеличение масштаба фрактала
    VK_Add: StepSize := StepSize + 1;
    
    // Уменьшение масштаба (не ниже 1)
    VK_Subtract: 
      if StepSize > 1 then StepSize := StepSize - 1;
    
    // Смещение области рисования влево
    VK_Left: StartX := StartX - 15;
    
    // Смещение области рисования вправо
    VK_Right: StartX := StartX + 15;
    
    // Смещение области рисования вверх
    VK_Up: StartY := StartY - 15;
    
    // Смещение области рисования вниз
    VK_Down: StartY := StartY + 15;
  end;
  
  // После любого действия выполняется полная перерисовка
  Redraw;
end;



begin
  // Установка размера окна приложения
  SetWindowSize(800, 800);
  
  // Назначение обработчика клавиатуры
  OnKeyDown := KeyDown;
  
  // Первичная отрисовка фрактала при запуске программы
  Redraw;
end.
